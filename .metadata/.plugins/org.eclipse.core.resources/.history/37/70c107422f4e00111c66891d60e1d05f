/*
 * ethernet_driver.h
 *
 * Owns:
 *   - lwIP netconn TCP server lifecycle (bind, listen, accept)
 *   - Active connection state
 *   - Raw byte send and receive over the TCP connection
 *   - Reconnect handling on link drop
 *
 * Architecture note:
 *   The STM32 acts as the TCP server on HALEY_SERVER_PORT.
 *   The Linux AI host connects as a client. Only one connection is
 *   supported at a time; a new inbound connection replaces the old one.
 *
 * Layer: Service / Ethernet Driver Layer
 * Dependencies: lwIP (netconn API), cmsis_os.h, ethernet_packets.h
 *
 *  Created on: May 12, 2026
 *      Author: jeffreya181
 */

#ifndef INC_ETHERNET_ETHERNET_DRIVER_H_
#define INC_ETHERNET_ETHERNET_DRIVER_H_

#include <stdint.h>
#include <stddef.h>
#include "cmsis_os.h"
#include "ethernet/ethernet_packets.h"

#ifdef __cplusplus
extern "C" {
#endif

/* -----------------------------------------------------------------------
 * Configuration
 * ----------------------------------------------------------------------- */

/** TCP port the STM32 listens on for AI host connections */
#define HALEY_SERVER_PORT            7000U

/** Maximum time (ms) to wait for a send to complete */
#define HALEY_SEND_TIMEOUT_MS        500U

/** Maximum time (ms) to wait on a receive before timing out */
#define HALEY_RECV_TIMEOUT_MS        5000U

/** Maximum time (ms) to wait for the network to be ready after boot */
#define HALEY_NETUP_WAIT_TIMEOUT_MS  30000U

/* -----------------------------------------------------------------------
 * Connection State
 * ----------------------------------------------------------------------- */

typedef enum {
    ETH_DRV_STATE_UNINIT      = 0,  /**< Driver not yet initialized          */
    ETH_DRV_STATE_WAITING     = 1,  /**< Waiting for lwIP / DHCP             */
    ETH_DRV_STATE_LISTENING   = 2,  /**< TCP server open, no client          */
    ETH_DRV_STATE_CONNECTED   = 3,  /**< AI host is connected                */
    ETH_DRV_STATE_ERROR       = 4,  /**< Unrecoverable error; needs reset    */
} eth_drv_state_t;

/* -----------------------------------------------------------------------
 * Result Codes
 * ----------------------------------------------------------------------- */

typedef enum {
    ETH_DRV_OK           =  0,
    ETH_DRV_ERR_NOT_INIT = -1,   /**< Driver not initialized                */
    ETH_DRV_ERR_NO_CONN  = -2,   /**< No active TCP connection              */
    ETH_DRV_ERR_SEND     = -3,   /**< TCP send failed                       */
    ETH_DRV_ERR_RECV     = -4,   /**< TCP receive failed or timed out       */
    ETH_DRV_ERR_TIMEOUT  = -5,   /**< Operation timed out                   */
    ETH_DRV_ERR_BUF      = -6,   /**< Buffer too small or NULL              */
    ETH_DRV_ERR_LWIP     = -7,   /**< lwIP netconn error                    */
} eth_drv_result_t;

/* -----------------------------------------------------------------------
 * Callbacks
 * ----------------------------------------------------------------------- */

/**
 * @brief  Callback invoked by the driver when a new client connects.
 * @param  client_ip_str  Null-terminated string of the client IP address.
 *                        Only valid for the duration of the callback.
 */
typedef void (*eth_drv_connect_cb_t)(const char *client_ip_str);

/**
 * @brief  Callback invoked by the driver when the connection is lost.
 */
typedef void (*eth_drv_disconnect_cb_t)(void);

/* -----------------------------------------------------------------------
 * API
 * ----------------------------------------------------------------------- */

/**
 * @brief  Initialize the Ethernet driver.
 *         Creates the internal netconn server and prepares for a client
 *         connection. Must be called after MX_LWIP_Init() completes.
 *
 *         Typical call site: ethernetRxTask, after waiting for SYSTEM_READY.
 *
 * @param  on_connect     Optional callback for new connections (may be NULL).
 * @param  on_disconnect  Optional callback for disconnects (may be NULL).
 * @return ETH_DRV_OK on success, or an eth_drv_result_t error code.
 */
eth_drv_result_t ETH_DRV_Init(eth_drv_connect_cb_t    on_connect,
                               eth_drv_disconnect_cb_t on_disconnect);

/**
 * @brief  Block until a client connects (or the driver is de-initialized).
 *         This function is intended to be called from ethernetRxTask in a loop.
 *
 * @return ETH_DRV_OK when a connection is accepted,
 *         ETH_DRV_ERR_LWIP on a netconn error.
 */
eth_drv_result_t ETH_DRV_WaitForConnection(void);

/**
 * @brief  Receive raw bytes from the active TCP connection.
 *
 *         This is a blocking call. Returns as soon as at least 1 byte is
 *         available, or when the timeout expires. Received data is appended
 *         to rx_buf starting at rx_buf[0].
 *
 * @param  rx_buf       Destination buffer.
 * @param  buf_size     Size of rx_buf.
 * @param  bytes_recvd  Output: number of bytes actually written to rx_buf.
 * @return ETH_DRV_OK on success, ETH_DRV_ERR_NO_CONN if disconnected,
 *         ETH_DRV_ERR_TIMEOUT on timeout, ETH_DRV_ERR_RECV on error.
 */
eth_drv_result_t ETH_DRV_Receive(uint8_t *rx_buf,
                                  size_t   buf_size,
                                  size_t  *bytes_recvd);

/**
 * @brief  Send a raw byte buffer over the active TCP connection.
 *
 * @param  tx_buf     Buffer to transmit.
 * @param  tx_len     Number of bytes to transmit.
 * @return ETH_DRV_OK on success, ETH_DRV_ERR_NO_CONN if disconnected,
 *         ETH_DRV_ERR_SEND on error.
 */
eth_drv_result_t ETH_DRV_Send(const uint8_t *tx_buf, size_t tx_len);

/**
 * @brief  Send a pre-built Haley packet buffer.
 *         Convenience wrapper around ETH_DRV_Send().
 *
 * @param  pkt_buf   Buffer containing a fully serialized Haley packet.
 * @param  pkt_len   Total length of the packet in bytes.
 * @return ETH_DRV_OK or an error code.
 */
eth_drv_result_t ETH_DRV_SendPacket(const uint8_t *pkt_buf, size_t pkt_len);

/**
 * @brief  Close the active client connection gracefully.
 *         The driver remains in LISTENING state after this call.
 */
void ETH_DRV_CloseConnection(void);

/**
 * @brief  Tear down the server and de-initialize the driver.
 *         After this call, ETH_DRV_Init() must be called again to restart.
 */
void ETH_DRV_DeInit(void);

/**
 * @brief  Query the current connection state.
 * @return Current eth_drv_state_t.
 */
eth_drv_state_t ETH_DRV_GetState(void);

/**
 * @brief  Returns 1 if an AI host is actively connected, 0 otherwise.
 */
int ETH_DRV_IsConnected(void);

#ifdef __cplusplus
}
#endif

#endif /* INC_ETHERNET_ETHERNET_DRIVER_H_ */
