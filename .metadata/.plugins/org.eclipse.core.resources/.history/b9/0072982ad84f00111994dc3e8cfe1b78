/**
 * @file ai_host_state.h
 * @brief Logic-level connection and health states for the AI Host interface.
 *
 * Mirrors ConnectionState and LinkHealth from stm32_state.py.
 */

#ifndef INC_AI_HOST_AI_HOST_STATE_H_
#define INC_AI_HOST_AI_HOST_STATE_H_

#include <stdint.h>
#include "protocol/protocol_types.h"

/**
 * @brief High-level connection states for the AI Host link.
 */
typedef enum {
    AI_HOST_DISCONNECTED = 0, /**< No physical link or no heartbeats detected */
    AI_HOST_CONNECTING,       /**< Physical link established, waiting for handshake */
    AI_HOST_CONNECTED,        /**< Handshake complete, heartbeats flowing */
    AI_HOST_FAULT             /**< Protocol mismatch or watchdog timeout */
} ai_host_conn_state_t;

/**
 * @brief Quantitative health of the communication link.
 */
typedef enum {
    AI_HOST_HEALTH_UNKNOWN = 0,
    AI_HOST_HEALTH_GOOD,
    AI_HOST_HEALTH_DEGRADED,  /**< CRC errors detected or high latency */
    AI_HOST_HEALTH_BAD        /**< Critical packet loss */
} ai_host_health_t;

/**
 * @brief Comprehensive state container for the AI Host interface.
 */
typedef struct {
    ai_host_conn_state_t conn_state;
    ai_host_health_t     health;

    uint32_t last_heartbeat_rx_ms;
    uint32_t last_packet_rx_ms;

    struct {
        uint32_t rx_count;
        uint32_t tx_count;
        uint32_t crc_errors;
        uint32_t parse_errors;
    } stats;
} ai_host_state_t;

#endif /* INC_AI_HOST_AI_HOST_STATE_H_ */
